# Recognize native Windows CRLF without treating carriage returns as whitespace.
* whitespace=cr-at-eol
android/gradlew text eol=lf
# Preserve inherited legal bytes, including original formatting, on every host.
LICENSE -text -whitespace
licenses/** -text -whitespace
# Upstream reStructuredText heading delimiters use seven '=' characters.
licenses/CRS/IAU-collection/AUTHORS.rst conflict-marker-size=32

# Packaged resources are verified byte-for-byte against Git on every host.
app/assets/** -text
app/locales/** -text
